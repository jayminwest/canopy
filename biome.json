{
	"$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
	"files": {
		"includes": ["src/**", "scripts/**", "!**/node_modules"]
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noForEach": "off",
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": { "maxLines": 500 }
				},
				"noExcessiveCognitiveComplexity": {
					"level": "error",
					"options": { "maxAllowedComplexity": 15 }
				}
			},
			"correctness": {
				"noUnusedVariables": "error",
				"noUnusedImports": "error"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"style": {
				"noNonNullAssertion": "warn",
				"useConst": "error",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"strictCase": true,
						"requireAscii": true,
						"filenameCases": ["kebab-case"]
					}
				}
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"overrides": [
		{
			"includes": ["scripts/check-all.ts", "scripts/check-ci-parity.ts"],
			"formatter": {
				"enabled": false
			}
		},
		{
			"includes": [
				"src/commands/archive.ts",
				"src/commands/completions.ts",
				"src/commands/create.ts",
				"src/commands/diff.ts",
				"src/commands/doctor.ts",
				"src/commands/emit.ts",
				"src/commands/history.ts",
				"src/commands/import.ts",
				"src/commands/list.ts",
				"src/commands/onboard.ts",
				"src/commands/pin.ts",
				"src/commands/render.ts",
				"src/commands/schema.ts",
				"src/commands/show.ts",
				"src/commands/sync.ts",
				"src/commands/tree.ts",
				"src/commands/update.ts",
				"src/commands/upgrade.ts",
				"src/commands/validate.ts",
				"src/config.ts",
				"src/frontmatter.ts",
				"src/render.ts",
				"src/validate.ts",
				"src/yaml.ts",
				"scripts/check-debt-markers.ts",
				"scripts/check-file-sizes.ts",
				"scripts/validate-agents-md.ts",
				"scripts/generate-cli-docs.ts"
			],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveCognitiveComplexity": "off"
					}
				}
			}
		},
		{
			"includes": ["src/render.test.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					}
				}
			}
		}
	]
}
